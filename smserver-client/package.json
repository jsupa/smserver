{
  "name": "smserver-client",
  "version": "1.0.2",
  "description": "TypeScript client for SMServer — iMessage gateway API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck",
    "publish:pnpm": "pnpm build && pnpm publish --no-git-checks",
    "debug": "tsx src/debug-server.ts",
    "debug:headless": "tsx src/debug-server.ts --no-interactive",
    "send": "tsx src/send-test.ts",
    "example:basic": "tsx examples/basic.ts",
    "example:realtime": "tsx examples/realtime.ts",
    "example:start": "tsx examples/start-chat.ts",
    "example:images": "tsx examples/images.ts",
    "example:seen": "tsx examples/seen-and-images.ts",
    "example:history": "tsx examples/read-history.ts",
    "example:send-media": "tsx examples/send-media.ts",
    "example:groups": "tsx examples/groups.ts",
    "example:search": "tsx examples/search.ts",
    "example:tapbacks": "tsx examples/tapbacks.ts"
  },
  "keywords": [
    "smserver",
    "imessage",
    "sms",
    "ios",
    "api-client"
  ],
  "packageManager": "pnpm@9.0.0",
  "author": "Jakub Supa <jakub.supa@icloud.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsupa/smserver.git",
    "directory": "smserver-client"
  },
  "homepage": "https://github.com/jsupa/smserver#readme",
  "bugs": {
    "url": "https://github.com/jsupa/smserver/issues"
  },
  "dependencies": {
    "got": "^14.6.6",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsdown": "^0.15.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
