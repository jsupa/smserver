{
  "name": "smserver-client",
  "version": "1.0.1",
  "description": "TypeScript client for SMServer — iMessage gateway API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck",
    "publish:pnpm": "pnpm build && pnpm publish --no-git-checks",
    "debug": "tsx src/debug-server.ts",
    "debug:headless": "tsx src/debug-server.ts --no-interactive",
    "send": "tsx src/send-test.ts",
    "example:basic": "tsx examples/basic.ts",
    "example:realtime": "tsx examples/realtime.ts",
    "example:start": "tsx examples/start-chat.ts",
    "example:images": "tsx examples/images.ts"
  },
  "keywords": [
    "smserver",
    "imessage",
    "sms",
    "ios",
    "api-client"
  ],
  "packageManager": "pnpm@9.0.0",
  "author": "Jakub Supa <jakub.supa@icloud.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsupa/smserver.git",
    "directory": "smserver-client"
  },
  "homepage": "https://github.com/jsupa/smserver#readme",
  "bugs": {
    "url": "https://github.com/jsupa/smserver/issues"
  },
  "dependencies": {
    "got": "^14.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0",
    "tsdown": "^0.15.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
